#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_CONFIG="$REPO_ROOT/local/gitconfig"
LINKS_FILE="$REPO_ROOT/local/.links"
TARGET="$HOME/.gitconfig.local"

existing_name="$(git config -f "$LOCAL_CONFIG" user.name 2>/dev/null || true)"
existing_email="$(git config -f "$LOCAL_CONFIG" user.email 2>/dev/null || true)"

name=""
while [[ -z "$name" ]]; do
    name=$(gum input --placeholder "Full name" --value "$existing_name")
done

email=""
while [[ -z "$email" ]]; do
    email=$(gum input --placeholder "Email address" --value "$existing_email")
done

git config -f "$LOCAL_CONFIG" user.name "$name"
git config -f "$LOCAL_CONFIG" user.email "$email"

# Ensure local/.links maps local/gitconfig to ~/.gitconfig.local. local/.links
# is gitignored, so it may not exist yet on a fresh clone.
touch "$LINKS_FILE"
grep -qxF 'gitconfig=.gitconfig.local' "$LINKS_FILE" || \
    echo 'gitconfig=.gitconfig.local' >> "$LINKS_FILE"

# Symlink directly here to apply the change immediately.
ln -sfn "$LOCAL_CONFIG" "$TARGET"

gum log --level info "✓ ~/.gitconfig.local linked"
