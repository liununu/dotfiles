command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
# Share history between all sessions.
setopt SHARE_HISTORY
# Delete an old command if a new command is a duplicate.
setopt HIST_IGNORE_ALL_DUPS
# Remove superfluous blanks from commands before saving.
setopt HIST_REDUCE_BLANKS
# Do not record commands that start with a space.
setopt HIST_IGNORE_SPACE

# Treat only letters and digits as word characters.
# Then <C-w> deletes one word, not a full path.
WORDCHARS=''

autoload -Uz compinit
compinit

# Case-insensitive, partial-word, and substring completion.
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'

autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

setopt PROMPT_SUBST
autoload -Uz add-zsh-hook

# Shorten the working directory for the prompt.
_prompt_shorten_dir() {
    local dir="${PWD/#$HOME/~}"
    local -a parts
    parts=("${(@s:/:)dir}")
    # Do not change a path that has two parts or less.
    if (( ${#parts} <= 2 )); then
        print -r -- "${dir//\%/%%}"
        return
    fi
    local -a shortened
    local part
    for part in "${(@)parts[1,-2]}"; do
        if [[ $part == .* ]]; then
            shortened+=("${part:0:2}")
        else
            shortened+=("${part:0:1}")
        fi
    done
    # The prompt treats "%" as an escape character. Write "%%" to show one "%".
    print -r -- "${(j:/:)shortened}/${parts[-1]//\%/%%}"
}

# Get the git data for the prompt.
_prompt_git_info() {
    _prompt_git=''
    local status_output
    # GIT_OPTIONAL_LOCKS=0 stops git from taking optional locks.
    # This prevents a conflict with the git commands of the user.
    status_output=$(GIT_OPTIONAL_LOCKS=0 command git status --porcelain=v2 --branch 2>/dev/null) || return

    local branch='' oid='' ahead=0 behind=0 dirty=0 untracked=0
    local line
    for line in ${(f)status_output}; do
        case $line in
            '# branch.oid '*)
                oid=${line#'# branch.oid '}
                ;;
            '# branch.head '*)
                branch=${line#'# branch.head '}
                ;;
            '# branch.ab '*)
                # Git writes "+0" or "-0" when the branch is in sync.
                [[ $line == *' +0 '* ]] || ahead=1
                [[ $line == *' -0' ]] || behind=1
                ;;
            [12u]' '*)
                dirty=1
                ;;
            '?'*)
                untracked=1
                ;;
        esac
    done

    # Use the short commit hash when the HEAD is detached.
    [[ $branch == '(detached)' ]] && branch=${oid[1,7]}

    local -a marks
    # The prompt treats "%" as an escape character. Write "%%" to show one "%".
    marks=("%F{magenta}${branch//\%/%%}")
    # The star marks changes and files that git does not track.
    (( dirty || untracked )) && marks[1]+='%F{yellow}*'
    (( ahead )) && marks+=('%F{yellow}↑')
    (( behind )) && marks+=('%F{yellow}↓')
    _prompt_git=" ${marks[*]}%f"
    return 0
}

# Set the prompt data before zsh writes each prompt.
_prompt_precmd() {
    local -i exit_code=$?
    _prompt_dir=$(_prompt_shorten_dir)
    _prompt_git_info
    if (( exit_code )); then
        _prompt_lambda='%F{red}'
    else
        _prompt_lambda='%F{green}'
    fi
    # Give the stored exit status to the hooks that run after this hook.
    return exit_code
}
add-zsh-hook precmd _prompt_precmd

# The lambda is green after a command that succeeded, and red after a command that failed.
PROMPT='${_prompt_lambda}λ%f %F{cyan}${_prompt_dir}%f${_prompt_git} '

alias ls='ls -G'
alias l='ls'
alias ll='ls -lh'
alias la='ls -lhA'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias grep='grep --color=auto'
alias gst='git status'
alias ga='git add'
alias gcmsg='git commit --message'
alias gd='git diff'
alias gds='git diff --staged'
alias gp='git push'
alias glg='git log --stat'
alias gpra='git pull --rebase --autostash'

gcm() { git checkout "$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')"; }
alias qrcode="pbpaste | qrencode -t ANSI"

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Load plugins.
[[ -f "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
# Syntax highlighting must load last.
[[ -f "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
